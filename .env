# =============================================================================
# Environnement TEST : fichier lu automatiquement par « docker compose ».
# Valeurs FACTICES, versionnées volontairement pour pouvoir lancer le projet en
# une commande juste après un clone. Les vrais secrets (UAT, PROD) ne sont
# JAMAIS versionnés : voir env/uat.env.example et env/prod.env.example.
# =============================================================================

# Nom du projet compose (préfixe des conteneurs, réseaux et volumes) : un par environnement
COMPOSE_PROJECT_NAME=villa-cote-azur-test
APP_ENV=test

# Images construites localement grâce au champ « build » du compose
REGISTRY=villa-cote-azur
IMAGE_TAG=local

# Port publié sur la machine hôte (le 8080 est souvent déjà utilisé)
FRONTEND_PORT=8081
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Mots de passe PostgreSQL : lettres, chiffres et « _ » uniquement (ils sont insérés dans des URL)
POSTGRES_PASSWORD=postgres_test
AUTH_DB_PASSWORD=auth_test
VILLA_DB_PASSWORD=villa_test
BOOKING_DB_PASSWORD=booking_test

# Compte administrateur créé au premier démarrage de l'auth-service
ADMIN_EMAIL=admin@villa.fr
ADMIN_PASSWORD=admin1234

# Limites de ressources (cgroups)
APP_CPUS=0.5
APP_MEM_LIMIT=256m
DB_CPUS=1
DB_MEM_LIMIT=512m
