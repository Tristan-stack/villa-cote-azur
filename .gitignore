# --- Dépendances : réinstallées dans les images Docker, jamais versionnées ---
node_modules/
.venv/
__pycache__/
*.py[cod]

# --- Caches et rapports de tests ---
.pytest_cache/
.ruff_cache/
coverage/
.coverage
htmlcov/

# --- Secrets des environnements UAT / PROD ---
# Seuls les modèles env/*.env.example sont versionnés.
# Le .env de la racine (valeurs factices de TEST) est versionné volontairement.
env/*.env

# --- Logs ---
*.log
npm-debug.log*

# --- PDF générés à partir de docs/ (envoyés par mail, pas versionnés) ---
/pdf/

# --- Éditeurs / OS ---
.idea/
.DS_Store
Thumbs.db
