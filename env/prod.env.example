# =============================================================================
# Environnement PROD, MODÈLE.
# 1. Copier ce fichier en env/prod.env (non versionné : voir .gitignore)
# 2. Remplacer les CHANGE_ME par des secrets forts (par exemple : openssl rand -hex 24)
# 3. Lancer avec l'image de la version publiée par la CI (même image qu'en TEST/UAT) :
#      docker compose --env-file env/prod.env pull
#      docker compose --env-file env/prod.env up -d --no-build
# =============================================================================

COMPOSE_PROJECT_NAME=villa-cote-azur-prod
APP_ENV=prod

# Toujours une version figée (tag git) en production, jamais « latest »
REGISTRY=ghcr.io/tristan-stack/projet-docker
IMAGE_TAG=v1.0.0

FRONTEND_PORT=80
# Cookie de session envoyé uniquement en HTTPS (suppose un reverse-proxy TLS devant le frontend)
COOKIE_SECURE=true
SESSION_TTL_HOURS=8

# Lettres, chiffres et « _ » uniquement (insérés dans des URL de connexion)
POSTGRES_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
VILLA_DB_PASSWORD=CHANGE_ME
BOOKING_DB_PASSWORD=CHANGE_ME

ADMIN_EMAIL=admin@villa-cote-azur.fr
ADMIN_PASSWORD=CHANGE_ME

# Plus de ressources qu'en TEST/UAT
APP_CPUS=1
APP_MEM_LIMIT=512m
DB_CPUS=2
DB_MEM_LIMIT=1g
