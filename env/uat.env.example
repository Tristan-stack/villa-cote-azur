# =============================================================================
# Environnement UAT (recette), MODÈLE.
# 1. Copier ce fichier en env/uat.env (non versionné : voir .gitignore)
# 2. Remplacer les CHANGE_ME (par exemple avec : openssl rand -hex 16)
# 3. Lancer avec les images publiées par la CI :
#      docker compose --env-file env/uat.env pull
#      docker compose --env-file env/uat.env up -d --no-build
# =============================================================================

COMPOSE_PROJECT_NAME=villa-cote-azur-uat
APP_ENV=uat

# Images publiées dans GHCR par la CI : tag = nom d'un tag git (ex. v0.1.0) ou SHA court d'un commit
REGISTRY=ghcr.io/tristan-stack/villa-cote-azur
IMAGE_TAG=v0.1.0

# Port différent de TEST : les deux environnements peuvent tourner côte à côte
FRONTEND_PORT=8082
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Lettres, chiffres et « _ » uniquement (insérés dans des URL de connexion)
POSTGRES_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
VILLA_DB_PASSWORD=CHANGE_ME
BOOKING_DB_PASSWORD=CHANGE_ME

ADMIN_EMAIL=admin@villa-uat.fr
ADMIN_PASSWORD=CHANGE_ME

APP_CPUS=0.5
APP_MEM_LIMIT=256m
DB_CPUS=1
DB_MEM_LIMIT=512m
