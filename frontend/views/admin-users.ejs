<%- include('partials/header', { title: 'Administration' }) %>
<% const admins = users.filter((u) => u.role === 'admin').length; %>
<div class="page-header">
  <h1 class="page-title">Administration</h1>
  <p class="page-description">Gérez les comptes des utilisateurs.</p>
</div>
<dl class="stats">
  <div class="card stat"><dt class="stat-label">Comptes</dt><dd class="stat-value"><%= users.length %></dd></div>
  <div class="card stat"><dt class="stat-label">Standard</dt><dd class="stat-value"><%= users.length - admins %></dd></div>
  <div class="card stat"><dt class="stat-label">Administrateurs</dt><dd class="stat-value"><%= admins %></dd></div>
</dl>
<% if (error) { %><div class="alert alert-destructive" role="alert"><%- icon('circle-alert') %><p><%= error %></p></div><% } %>
<div class="table-card">
  <div class="table-container">
    <table class="table">
      <thead>
        <tr><th>#</th><th>Email</th><th>Type</th><th>Inscrit le</th><th><span class="sr-only">Actions</span></th></tr>
      </thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr data-user-id="<%= u.id %>" data-user-email="<%= u.email %>">
            <td class="muted"><%= u.id %></td>
            <td class="cell-title"><%= u.email %></td>
            <td><span class="badge<%= u.role === 'admin' ? '' : ' badge-secondary' %>"><%= u.role %></span></td>
            <td><%= new Date(u.createdAt).toLocaleDateString('fr-FR') %></td>
            <td class="table-actions">
              <% if (u.role === 'standard') { %>
                <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Supprimer ce compte et ses réservations ?')">
                  <button class="btn btn-outline btn-sm btn-danger-text" type="submit"><%- icon('trash-2') %>Supprimer</button>
                </form>
              <% } else { %>
                <span class="text-sm muted with-icon"><%- icon('lock') %>Protégé</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<p class="text-sm muted note">Un administrateur peut supprimer les comptes standard, mais pas les autres administrateurs.</p>
<%- include('partials/footer') %>
