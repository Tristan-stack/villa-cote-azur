<%- include('partials/header', { title: 'Mes réservations' }) %>
<section class="page-head">
  <p class="eyebrow">Votre espace</p>
  <h1 class="page-title">Mes <em>réservations</em></h1>
</section>
<% if (bookings.length === 0) { %>
  <div class="empty-state">
    <p>Vous n'avez pas encore de réservation.</p>
    <a class="btn" href="/villas">Découvrir les villas</a>
  </div>
<% } else { %>
  <ul class="tickets">
    <% bookings.forEach((b) => { %>
      <li class="ticket" data-reveal>
        <div class="ticket__media">
          <% if (b.villa) { %><%- include('partials/postcard', { villa: b.villa, uid: 'booking-' + b.id }) %><% } %>
        </div>
        <div class="ticket__info">
          <p class="eyebrow"><%= b.villa ? b.villa.city : 'Villa' %></p>
          <h2 class="ticket__name"><%= b.villa ? b.villa.name : 'Villa n°' + b.villa_id %></h2>
          <div class="ticket__dates">
            <p><span>Arrivée</span><strong><%= formatDate(b.start_date) %></strong></p>
            <span class="ticket__arrow" aria-hidden="true">→</span>
            <p><span>Départ</span><strong><%= formatDate(b.end_date) %></strong></p>
          </div>
        </div>
        <div class="ticket__stub">
          <p><span><%= b.nights %> nuit<%= b.nights > 1 ? 's' : '' %></span><strong><%= b.total !== null ? formatPrice(b.total) : '—' %></strong></p>
          <form method="post" action="/bookings/<%= b.id %>/cancel" onsubmit="return confirm('Annuler cette réservation ?')">
            <button class="btn btn--outline btn--small" type="submit">Annuler</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('partials/footer') %>
