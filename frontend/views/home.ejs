<%- include('partials/header', { title: 'Accueil' }) %>
<section class="hero">
  <a class="announcement" href="/villas">
    <%- icon('sun') %><%= villaCount ? villaCount + ' villas disponibles cet été' : 'Locations de villas sur la Riviera' %><%- icon('arrow-right') %>
  </a>
  <h1 class="hero-title">Des villas d'exception sur la Côte d'Azur.</h1>
  <p class="hero-description">Nice, Cannes, Antibes, Saint-Tropez, Menton et Èze. Consultez les disponibilités et
    réservez votre séjour en quelques clics.</p>
  <div class="hero-actions">
    <a class="btn btn-lg" href="/villas">Découvrir les villas<%- icon('arrow-right') %></a>
    <% if (!user) { %><a class="btn btn-outline btn-lg" href="/register">Créer un compte</a><% } %>
  </div>
</section>

<% if (villaCount) { %>
  <dl class="stats">
    <div class="card stat"><dt class="stat-label">Villas</dt><dd class="stat-value"><%= villaCount %></dd></div>
    <div class="card stat"><dt class="stat-label">Destinations</dt><dd class="stat-value"><%= cityCount %></dd></div>
    <div class="card stat"><dt class="stat-label">Nuit dès</dt><dd class="stat-value"><%= formatPrice(minPrice) %></dd></div>
  </dl>
<% } %>

<% if (featured.length) { %>
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Notre sélection</h2>
        <p class="muted">Trois adresses pour commencer.</p>
      </div>
      <a class="btn btn-ghost btn-sm" href="/villas">Toutes les villas<%- icon('arrow-right') %></a>
    </div>
    <div class="grid grid-3">
      <% featured.forEach((villa) => { %><%- include('partials/villa-card', { villa }) %><% }) %>
    </div>
  </section>
<% } %>

<section class="section">
  <div class="section-header">
    <div>
      <h2 class="section-title">Comment ça marche</h2>
      <p class="muted">Trois étapes, aucune surprise.</p>
    </div>
  </div>
  <ol class="grid grid-3">
    <li class="card">
      <div class="card-header">
        <span class="step-number">1</span>
        <h3 class="card-title">Créez votre compte</h3>
        <p class="card-description">Un email et un mot de passe suffisent.</p>
      </div>
    </li>
    <li class="card">
      <div class="card-header">
        <span class="step-number">2</span>
        <h3 class="card-title">Choisissez votre villa</h3>
        <p class="card-description">Filtrez par ville et consultez les dates déjà réservées.</p>
      </div>
    </li>
    <li class="card">
      <div class="card-header">
        <span class="step-number">3</span>
        <h3 class="card-title">Réservez vos dates</h3>
        <p class="card-description">Le prix total est calculé en direct, puis le séjour apparaît dans votre espace.</p>
      </div>
    </li>
  </ol>
</section>
<%- include('partials/footer') %>
