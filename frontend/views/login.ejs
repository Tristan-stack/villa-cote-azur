<%- include('partials/header', { title: 'Connexion', bodyClass: 'page-auth' }) %>
<div class="auth">
  <aside class="auth__visual">
    <%- include('partials/postcard', { villa: showcaseVilla, uid: 'auth', className: 'postcard--live', aspect: 'xMaxYMid' }) %>
    <blockquote class="auth__quote">« Le soleil, la mer,<br>et rien d'autre à prévoir. »</blockquote>
  </aside>
  <section class="auth__panel">
    <p class="eyebrow">Bon retour</p>
    <h1 class="page-title">Connexion</h1>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <form method="post" action="/login" class="form">
      <input type="hidden" name="next" value="<%= next %>">
      <label>Email
        <input type="email" name="email" value="<%= email %>" autocomplete="email" required autofocus>
      </label>
      <label>Mot de passe
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="btn btn--block" type="submit">Se connecter</button>
    </form>
    <p class="auth__switch">Pas encore de compte ? <a href="/register">Créer un compte</a></p>
  </section>
</div>
<%- include('partials/footer') %>
