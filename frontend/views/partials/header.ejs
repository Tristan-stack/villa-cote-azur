<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Villa sur la Côte d'Azur</title>
  <meta name="description" content="Locations de villas sur la Côte d'Azur : Nice, Cannes, Antibes, Saint-Tropez, Menton et Èze.">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23171717'/%3E%3Cg fill='none' stroke='%23fafafa' stroke-width='2' stroke-linecap='round' transform='translate(4 4)'%3E%3Ccircle cx='12' cy='12' r='4'/%3E%3Cpath d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'/%3E%3C/g%3E%3C/svg%3E">
  <link rel="preload" href="/fonts/geist/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <script src="/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body>
  <a class="skip-link btn" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <div class="container site-header__inner">
      <a class="brand" href="/">
        <span class="brand__logo"><%- icon('sun') %></span>
        <span>Villa<span class="brand__long"> sur la Côte d'Azur</span></span>
      </a>
      <% if (user) { %>
        <% const links = [['/villas', 'Villas'], ['/bookings', 'Mes réservations']];
           if (user.role === 'admin') links.push(['/admin/users', 'Administration']);
           links.push(['/account', 'Mon compte']); %>
        <nav class="nav" aria-label="Navigation principale">
          <% links.forEach(([href, label]) => { %>
            <a href="<%= href %>"<%- currentPath.startsWith(href) ? ' aria-current="page"' : '' %>><%= label %></a>
          <% }) %>
        </nav>
        <div class="header-actions">
          <span class="header-user"><%= user.email %></span>
          <form method="post" action="/logout">
            <button class="btn btn-outline btn-sm" type="submit"><%- icon('log-out') %>Déconnexion</button>
          </form>
        </div>
      <% } else { %>
        <div class="header-actions">
          <a class="btn btn-ghost btn-sm" href="/login">Connexion</a>
          <a class="btn btn-sm" href="/register">Créer un compte</a>
        </div>
      <% } %>
    </div>
  </header>
  <% if (message) { %><div class="toast" role="status"><%- icon('check') %><span><%= message %></span></div><% } %>
  <main id="contenu" class="container">
