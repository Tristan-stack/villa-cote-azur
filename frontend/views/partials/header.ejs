<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Villa sur la Côte d'Azur</title>
  <meta name="description" content="Locations de villas d'exception sur la Côte d'Azur : Nice, Cannes, Antibes, Saint-Tropez, Menton et Èze.">
  <meta name="theme-color" content="#071827">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='13' r='7' fill='%23f2c14e'/%3E%3Cpath d='M3 24q6.5-5 13 0t13 0' fill='none' stroke='%231f5fae' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
  <link rel="preload" href="/fonts/fraunces/fraunces-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/manrope/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <script>document.documentElement.classList.add('js')</script>
  <script src="/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="16" r="9" fill="#f2c14e"/>
        <path d="M4 30q8-6 16 0t16 0" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <span class="brand-text">Villa <em>sur la Côte d'Azur</em></span>
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      <% if (user) { %>
        <a href="/villas">Villas</a>
        <a href="/bookings">Mes réservations</a>
        <% if (user.role === 'admin') { %><a href="/admin/users">Administration</a><% } %>
        <a href="/account">Mon compte</a>
        <form method="post" action="/logout" class="inline"><button class="nav-button" type="submit">Déconnexion</button></form>
      <% } else { %>
        <a href="/login">Connexion</a>
        <a href="/register" class="btn btn--small">Créer un compte</a>
      <% } %>
    </nav>
  </header>
  <% if (message) { %><p class="toast" role="status"><%= message %></p><% } %>
  <main id="contenu">
