<article class="card villa-card">
  <div class="card-header">
    <div class="villa-card__top">
      <span class="badge badge-outline"><%- icon('map-pin') %><%= villa.city %></span>
      <p class="villa-card__price"><strong><%= formatPrice(villa.price_per_night) %></strong> / nuit</p>
    </div>
    <h3 class="card-title"><a class="stretched-link" href="/villas/<%= villa.id %>"><%= villa.name %></a></h3>
    <% if (villa.description) { %><p class="card-description line-clamp-2"><%= villa.description %></p><% } %>
  </div>
  <div class="card-footer villa-card__footer">
    <ul class="meta">
      <li><%- icon('users') %><%= villa.capacity %> voyageurs</li>
      <li><%- icon('bed-double') %><%= villa.bedrooms %> chambres</li>
    </ul>
    <% if (villa.has_pool || villa.sea_view) { %>
      <div class="badges">
        <% if (villa.has_pool) { %><span class="badge badge-secondary">Piscine</span><% } %>
        <% if (villa.sea_view) { %><span class="badge badge-secondary">Vue mer</span><% } %>
      </div>
    <% } %>
  </div>
</article>
