<%- include('partials/header', { title: 'Créer un compte' }) %>
<div class="auth">
  <section class="card auth__card">
    <div class="card-header">
      <h1 class="card-title auth__title">Créer un compte</h1>
      <p class="card-description">Un email et un mot de passe suffisent pour réserver votre villa.</p>
    </div>
    <div class="card-content">
      <% if (error) { %><div class="alert alert-destructive" role="alert"><%- icon('circle-alert') %><p><%= error %></p></div><% } %>
      <form method="post" action="/register" class="form">
        <div class="field">
          <label class="label" for="email">Email</label>
          <input class="input" id="email" type="email" name="email" value="<%= email %>" placeholder="vous@exemple.fr" autocomplete="email" required autofocus>
        </div>
        <div class="field">
          <label class="label" for="password">Mot de passe</label>
          <input class="input" id="password" type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" aria-describedby="password-hint" required>
          <p class="field-hint" id="password-hint">8 caractères minimum.</p>
        </div>
        <button class="btn btn-block" type="submit">Créer mon compte</button>
      </form>
      <p class="auth__switch">Déjà inscrit ? <a class="link" href="/login">Se connecter</a></p>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
