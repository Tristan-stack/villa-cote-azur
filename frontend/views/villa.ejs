<%- include('partials/header', { title: villa.name }) %>
<nav class="crumbs" aria-label="Fil d'Ariane"><a href="/villas">← Toutes les villas</a></nav>
<section class="villa-hero">
  <p class="eyebrow"><%= villa.city %> · Côte d'Azur</p>
  <h1 class="page-title"><%= villa.name %></h1>
  <ul class="tags">
    <li><%= villa.capacity %> voyageurs</li>
    <li><%= villa.bedrooms %> chambres</li>
    <% if (villa.has_pool) { %><li>Piscine privée</li><% } %>
    <% if (villa.sea_view) { %><li>Vue sur la mer</li><% } %>
  </ul>
</section>
<div class="villa-layout">
  <div class="villa-main">
    <div class="villa-visual">
      <%- include('partials/postcard', { villa, uid: 'detail', className: 'postcard--live' }) %>
    </div>
    <p class="villa-description"><%= villa.description %></p>
    <section>
      <h2 class="block-title">Disponibilités</h2>
      <% if (periods.length === 0) { %>
        <p class="muted">Aucune réservation à venir : toutes les dates sont libres.</p>
      <% } else { %>
        <ul class="periods">
          <% periods.forEach((p) => { %>
            <li><span>Réservé</span> du <%= formatDate(p.start_date) %> au <%= formatDate(p.end_date) %></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
  <aside class="booking-card" aria-labelledby="booking-title">
    <p class="booking-card__price"><strong><%= formatPrice(villa.price_per_night) %></strong> / nuit</p>
    <h2 id="booking-title" class="booking-card__title">Réserver cette villa</h2>
    <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
    <form method="post" action="/villas/<%= villa.id %>/book" class="form" data-booking data-price="<%= villa.price_per_night %>">
      <label>Arrivée
        <input type="date" name="start_date" min="<%= minDate %>" value="<%= form.start_date || '' %>" required>
      </label>
      <label>Départ
        <input type="date" name="end_date" min="<%= minDate %>" value="<%= form.end_date || '' %>" required>
      </label>
      <p class="booking-card__total" data-total aria-live="polite">Choisissez vos dates</p>
      <button class="btn btn--block" type="submit">Réserver ces dates</button>
    </form>
    <p class="booking-card__note">Démonstration : aucun paiement n'est demandé.</p>
  </aside>
</div>
<%- include('partials/footer') %>
